{
  "name": "starter-kit-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "mail:log": "tsx scripts/mail-log.ts",
    "privacy:requests": "tsx scripts/privacy-requests.ts",
    "auth:generate": "auth generate --config src/lib/auth/server.ts --output src/lib/db/auth-schema.ts --yes && node scripts/fix-auth-schema.mjs",
    "design:reference": "tsx scripts/reference.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.2",
    "@date-fns/tz": "1.5.0",
    "@neondatabase/serverless": "1.1.0",
    "@sentry/nextjs": "10.73.0",
    "@vercel/analytics": "2.0.1",
    "better-auth": "1.7.2",
    "class-variance-authority": "0.7.1",
    "cn": "0.2.5",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.2",
    "geist": "1.7.2",
    "lucide-react": "1.41.0",
    "next": "16.3.4",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.26.0",
    "shadcn": "4.21.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vercel/config": "0.7.0",
    "auth": "1.7.2",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
